# =============================================================================
# Legal Metrology Packaged Commodities Compliance Checker — Go Backend
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# =============================================================================

# ---- Runtime -----------------------------------------------------------------
GO_ENV=development
PORT=4000
LOG_LEVEL=debug
API_PREFIX=/api/v1

# ---- PostgreSQL (source of truth, via sqlc + pgx) -----------------------------
DATABASE_URL=postgres://postgres:postgres@localhost:5432/legal_metrology?sslmode=disable

# ---- MongoDB (raw OCR / CV / ML documents) -----------------------------------
MONGODB_URI=mongodb://localhost:27017/legal_metrology_ml

# ---- Redis (Asynq queues, cache, locks, rate limiting) -----------------------
REDIS_URL=redis://localhost:6379

# ---- JWT auth ----------------------------------------------------------------
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ---- Object storage (S3 / MinIO) ---------------------------------------------
# For local MinIO: S3_ENDPOINT=localhost:9000, S3_USE_SSL=false, S3_FORCE_PATH_STYLE=true
S3_ENDPOINT=localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=legal-metrology
S3_FORCE_PATH_STYLE=true
S3_USE_SSL=false
S3_PUBLIC_URL=http://localhost:9000
S3_SIGNED_URL_TTL=900

# ---- Python ML service (OpenCV / PaddleOCR / custom models) ------------------
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_TIMEOUT_MS=30000
ML_SERVICE_API_KEY=change-me-ml-service-key

# ---- Python Rule Engine service (deterministic Legal Metrology rule engine) --
# Owns the actual compliance decision (POST /validate), the rule registry
# (GET /rules) and its own health check (GET /health). The Go backend never
# evaluates legal rules itself — it only calls this service and persists the
# JSON it returns.
RULE_ENGINE_SERVICE_URL=http://localhost:8001
RULE_ENGINE_SERVICE_TIMEOUT_MS=15000
RULE_ENGINE_SERVICE_API_KEY=

# ---- Uploads / limits --------------------------------------------------------
MAX_UPLOAD_SIZE_BYTES=15728640
ALLOWED_IMAGE_MIME=image/jpeg,image/png,image/webp

# ---- Rate limiting -----------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# ---- CORS --------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000

# ---- Seed (cmd/seed) ----------------------------------------------------------
ADMIN_EMAIL=admin@legalmetrology.local
ADMIN_PASSWORD=ChangeMe123!
# Seeds illustrative EXAMPLE legal rule templates for local dev only (see
# cmd/seed). Leave unset/false in any environment used for real compliance
# decisions — populate the legal-rule repository from the authoritative Legal
# Metrology (Packaged Commodities) Rules, 2011 text instead.
SEED_EXAMPLE_RULES=false

# ---- Migrations (cmd/migrate) --------------------------------------------------
# Directory golang-migrate reads *.up.sql/*.down.sql from, relative to cwd.
MIGRATIONS_PATH=migrations

# ---- Infra tests (go test ./..., see pkg/*/*.go _test.go and cmd/migrate) -----
# Optional. Point these at disposable/scratch services (NOT dev data) to run
# the live infrastructure connectivity tests; unset (default) skips them.
# TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/legal_metrology_test?sslmode=disable
# TEST_MONGODB_URI=mongodb://localhost:27017/legal_metrology_ml_test
# TEST_REDIS_URL=redis://localhost:6379/1
# TEST_S3_ENDPOINT=localhost:9000
# TEST_S3_ACCESS_KEY=minioadmin
# TEST_S3_SECRET_KEY=minioadmin
# TEST_S3_BUCKET=legal-metrology-test
