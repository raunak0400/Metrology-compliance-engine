# =============================================================================
# Legal Metrology Packaged Commodities Compliance Checker — Backend
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# =============================================================================

# ---- Runtime -----------------------------------------------------------------
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug
API_PREFIX=/api/v1

# ---- PostgreSQL (source of truth, via Prisma) --------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/legal_metrology?schema=public

# ---- MongoDB (raw OCR / CV / ML documents) -----------------------------------
MONGODB_URI=mongodb://localhost:27017/legal_metrology_ml

# ---- Redis (BullMQ queues, cache, locks, rate limiting) ----------------------
REDIS_URL=redis://localhost:6379

# ---- JWT auth ----------------------------------------------------------------
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ---- Object storage (S3 / MinIO) ---------------------------------------------
# For local MinIO: S3_ENDPOINT=http://localhost:9000 and S3_FORCE_PATH_STYLE=true
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=legal-metrology
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_URL=http://localhost:9000
S3_SIGNED_URL_TTL=900

# ---- Python ML service (OpenCV / PaddleOCR / custom models) ------------------
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_TIMEOUT_MS=30000
ML_SERVICE_API_KEY=change-me-ml-service-key

# ---- Uploads / limits --------------------------------------------------------
MAX_UPLOAD_SIZE_BYTES=15728640
ALLOWED_IMAGE_MIME=image/jpeg,image/png,image/webp

# ---- Rate limiting -----------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# ---- CORS --------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000
