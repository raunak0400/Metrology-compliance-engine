{
  "root": true,
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
    "ecmaVersion": 2021,
    "sourceType": "module"
  },
  "env": {
    "node": true,
    "es2021": true,
    "jest": true
  },
  "ignorePatterns": ["dist", "node_modules", "coverage"],
  "rules": {
    "no-unused-vars": "off",
    "no-console": "warn"
  }
}
